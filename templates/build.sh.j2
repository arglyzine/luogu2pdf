#!/usr/bin/env bash
# 一键重新编译全部题面（并行）：每道题 + 合集
# 两遍：第一遍 -no-pdf（写 aux 不产 PDF，省时），第二遍正式输出收敛引用
# xelatex 日志静默，只显示进度与失败摘要
set -euo pipefail
cd "$(dirname "$0")"

# minted 需要 pygmentize，优先使用项目 .venv 的版本
export PATH="$(pwd)/{{ venv }}:$PATH"

files=(*.tex)
njobs=$(nproc 2>/dev/null || echo 2)
count=$(printf '%s\n' "${files[@]}" | wc -l)
[ "$njobs" -gt "$count" ] && njobs="$count"
[ "$njobs" -lt 1 ] && njobs=1

echo "[build] 第一遍（$njobs 并发，-no-pdf）"
printf '%s\n' "${files[@]}" | xargs -P "$njobs" -I{} \
  xelatex -no-pdf -shell-escape -interaction=nonstopmode -halt-on-error {} >/dev/null 2>&1 || true

echo "[build] 第二遍：收敛引用（TotPages）"
printf '%s\n' "${files[@]}" | xargs -P "$njobs" -I{} \
  xelatex -shell-escape -interaction=nonstopmode -halt-on-error {} >/dev/null 2>&1 || true

# 对账：每个 tex 是否产出 PDF
failed=0
for f in "${files[@]}"; do
  if [ ! -f "${f%.tex}.pdf" ]; then
    echo "[build] 失败: $f"
    tail -n 15 "${f%.tex}.log" 2>/dev/null | sed 's/^/    /' || true
    failed=1
  fi
done
[ "$failed" -eq 1 ] && exit 1

cp *.pdf ..
echo "[build] 完成：$(ls *.pdf | wc -l) 个 PDF（已复制到上级目录）"
