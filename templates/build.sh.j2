#!/usr/bin/env bash
# 一键重新编译全部题面：每道题 + 合集，共 $(ls *.tex | wc -l) 个 PDF
# 并行编译（文件间独立）；第一遍 -draftmode 只生成 aux（引用解析），第二遍正式输出
set -euo pipefail
cd "$(dirname "$0")"

# minted 需要 pygmentize，优先使用项目 .venv 的版本
export PATH="$(pwd)/{{ venv }}:$PATH"

files=(*.tex)
njobs=$(nproc 2>/dev/null || echo 2)
count=$(printf '%s\n' "${files[@]}" | wc -l)
[ "$njobs" -gt "$count" ] && njobs="$count"
[ "$njobs" -lt 1 ] && njobs=1

# 第一遍：draftmode（不写 PDF），并行，容忍个别失败
printf '%s\n' "${files[@]}" | xargs -P "$njobs" -I{} sh -c \
  'xelatex -draftmode -shell-escape -interaction=nonstopmode -halt-on-error "$1" >/dev/null 2>&1 || true' _ {}

# 第二遍：正式输出 PDF，并行，严格（任一失败即退出）
printf '%s\n' "${files[@]}" | xargs -P "$njobs" -I{} \
  xelatex -shell-escape -interaction=nonstopmode -halt-on-error {}

# 把生成的 PDF 复制到上级目录（output/<比赛名>/）
cp *.pdf ..
echo "完成：生成 $(ls *.pdf | wc -l) 个 PDF（已复制到上级目录）"
